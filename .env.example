# Copy this file to .env and fill in real values. .env is gitignored.

# From your Plaid dashboard (https://dashboard.plaid.com) after requesting Trial plan access.
PLAID_CLIENT_ID=
PLAID_SECRET_SANDBOX=
PLAID_SECRET_PROD=

# sandbox while testing, production once you link your real Amex card.
PLAID_ENV=sandbox

# Any random string, used to sign Flask session cookies.
FLASK_SECRET_KEY=change-me

# Keep false unless actively debugging on a trusted local machine. Never
# enable the interactive Flask debugger on a public deployment.
FLASK_DEBUG=false

# Set true only for the mock-data portfolio demo.
DEMO_MODE=false
